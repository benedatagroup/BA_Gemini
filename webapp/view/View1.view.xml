<mvc:View
    controllerName="bagemini.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <f:DynamicPage id="dynamicPageId" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:FilterBar id="filterBar" clear="onReset" search="onSearch" useToolbar="false" showGoOnFB="true" showClearOnFB="true">
                    <fb:filterGroupItems>
                        <!-- Basic Search Box as Filter Item to keep it in the Filter Bar natively -->
                        <fb:FilterGroupItem groupName="G1" name="Search" label="{i18n>searchLabel}" visibleInFilterBar="true">
                            <fb:control>
                                <SearchField id="searchField" placeholder="{i18n>searchPlaceholder}" search="onSearch" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        
                        <fb:FilterGroupItem groupName="G1" name="Status" label="{i18n>columnStatus}" visibleInFilterBar="true">
                            <fb:control>
                                <Select id="statusFilter" selectedKey="All">
                                    <core:Item key="All" text="{i18n>statusAll}" />
                                    <core:Item key="Draft" text="{i18n>statusDraft}" />
                                    <core:Item key="Posted" text="{i18n>statusPosted}" />
                                </Select>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- Weitere Filterfelder -->
                        <fb:FilterGroupItem groupName="G1" name="Date" label="{i18n>filterDate}" visibleInFilterBar="true">
                            <fb:control>
                                <DateRangeSelection id="dateFilter" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        
                        <fb:FilterGroupItem groupName="G1" name="Currency" label="{i18n>filterCurrency}" visibleInFilterBar="true">
                            <fb:control>
                                <ComboBox id="currencyFilter">
                                    <core:Item key="EUR" text="EUR" />
                                    <core:Item key="USD" text="USD" />
                                    <core:Item key="CHF" text="CHF" />
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>
        
        <f:content>
            <Table
                id="invoiceTable"
                inset="false"
                items="{
                    path: '/Invoices',
                    sorter: {
                        path: 'InvoiceDate',
                        descending: true
                    }
                }">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>title}" level="H2"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>btnCreate}" type="Emphasized" press=".onCreateInvoicePress"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>columnInvoiceNumber}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>columnVendor}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>columnInvoiceDate}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>columnGrossAmount}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>columnStatus}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onListItemPress">
                        <cells>
                            <ObjectIdentifier title="{InvoiceNumber}" text="{InvoiceId}"/>
                            <Text text="{VendorName}" />
                            <Text text="{
                                path: 'InvoiceDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    style: 'medium'
                                }
                            }" />
                            <ObjectNumber
                                number="{
                                    path: 'GrossAmount',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2
                                    }
                                }"
                                unit="{Currency}" />
                            <ObjectStatus
                                text="{= ${Status} === 'Draft' ? ${i18n>statusDraft} : ${i18n>statusPosted} }"
                                state="{= ${Status} === 'Draft' ? 'Error' : 'Success' }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>