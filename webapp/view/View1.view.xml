<mvc:View
    controllerName="bagemini.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    displayBlock="true">
    
    <f:DynamicPage id="dynamicPageId" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <smartFilterBar:SmartFilterBar id="smartFilterBar" entitySet="Invoices" persistencyKey="SmartFilterPKey" enableBasicSearch="true"/>
            </f:DynamicPageHeader>
        </f:header>
        
        <f:content>
            <VBox>
                <viz:VizFrame id="invoiceVizFrame" uiConfig="{applicationSet:'fiori'}" vizType="column" height="300px" width="100%">
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{chartModel>/Data}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name="Month" value="{chartModel>Month}" />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition name="Count" value="{chartModel>Count}" />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Count" />
                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Month" />
                    </viz:feeds>
                </viz:VizFrame>
                <smartTable:SmartTable
                    id="invoiceSmartTable"
                    entitySet="Invoices"
                    smartFilterId="smartFilterBar"
                    tableType="Table"
                    useExportToExcel="false"
                    useVariantManagement="false"
                    useTablePersonalisation="true"
                    header="{i18n>title}"
                    showRowCount="true"
                    enableAutoBinding="true"
                    noData="Keine Daten"
                    initiallyVisibleFields="InvoiceNumber,VendorName,InvoiceDate,GrossAmount,Status"
                    requestAtLeastFields="InvoiceId"
                    class="sapUiResponsiveContentPadding">
                    <smartTable:customToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer/>
                            <Button text="{i18n>btnCreate}" type="Emphasized" press=".onCreateInvoicePress"/>
                        </OverflowToolbar>
                    </smartTable:customToolbar>
                    <Table id="invoiceTable" updateFinished=".onTableUpdateFinished" mode="SingleSelectMaster" selectionChange=".onListItemPress">
                    </Table>
                </smartTable:SmartTable>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>