<mvc:View
    controllerName="bagemini.controller.Object"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">
    <uxap:ObjectPageLayout id="objectPageId" showTitleInHeaderContent="true" showFooter="true">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{InvoiceNumber}" wrapping="true" class="sapUiSmallMarginEnd"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="{InvoiceNumber}" wrapping="true"/>
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <Text text="{VendorName}"/>
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text text="{VendorName}"/>
                </uxap:snappedContent>
                <uxap:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" tooltip="{i18n>backButton}"/>
                </uxap:navigationActions>
                <uxap:actions>
                    <Button text="{i18n>btnEdit}" type="Emphasized" press=".onEdit" visible="{= !${objectView>/editMode} }"/>
                    <Button text="{i18n>btnSave}" type="Emphasized" press=".onSave" visible="{objectView>/editMode}"/>
                    <Button text="{i18n>btnCancel}" press=".onCancel" visible="{objectView>/editMode}"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        
        <uxap:headerContent>
            <FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
                <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                    <Title text="{i18n>headerStatus}" class="sapUiTinyMarginBottom"/>
                    <ObjectStatus
                        text="{= ${Status} === 'Draft' ? ${i18n>statusDraft} : ${i18n>statusPosted} }"
                        state="{= ${Status} === 'Draft' ? 'Error' : 'Success' }"/>
                </VBox>
                <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                    <Title text="{i18n>headerNetAmount}" class="sapUiTinyMarginBottom"/>
                    <ObjectNumber number="{ path: 'NetAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" unit="{Currency}"/>
                </VBox>
                <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                    <Title text="{i18n>headerGrossAmount}" class="sapUiTinyMarginBottom"/>
                    <ObjectNumber number="{ path: 'GrossAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" unit="{Currency}"/>
                </VBox>
            </FlexBox>
        </uxap:headerContent>
        
        <uxap:sections>
            <uxap:ObjectPageSection title="{i18n>sectionGeneralInfo}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
                                <form:content>
                                    <Label text="{i18n>fieldVendorName}" />
                                    <Text text="{VendorName}" visible="{= !${objectView>/editMode} }"/>
                                    <Input value="{VendorName}" visible="{objectView>/editMode}" />
                                    
                                    <Label text="{i18n>fieldCurrency}" />
                                    <Text text="{Currency}" visible="{= !${objectView>/editMode} }"/>
                                    <Input value="{Currency}" visible="{objectView>/editMode}" />

                                    <Label text="{i18n>fieldInvoiceDate}" />
                                    <Text text="{ path: 'InvoiceDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium' } }" />
                                    
                                    <Label text="{i18n>fieldDueDate}" />
                                    <Text text="{ path: 'DueDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium' } }" visible="{= !${objectView>/editMode} }"/>
                                    <DatePicker value="{ path: 'DueDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium' } }" visible="{objectView>/editMode}" />
                                    
                                    <Label text="{i18n>fieldStatus}" />
                                    <Text text="{= ${Status} === 'Draft' ? ${i18n>statusDraft} : ${i18n>statusPosted} }" />
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            
            <uxap:ObjectPageSection title="{i18n>sectionItems}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="invoiceItemsTable" 
                                items="{
                                    path: 'InvoiceItems',
                                    templateShareable: true
                                }"
                                mode="{= ${objectView>/editMode} ? 'Delete' : 'None' }"
                                delete=".onDeleteItem">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="{i18n>sectionItems}" level="H2"/>
                                        <ToolbarSpacer/>
                                        <Button text="{i18n>btnAddItem}" press=".onAddItem" visible="{objectView>/editMode}"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="{i18n>columnDescription}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnQuantity}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnUnitPrice}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnTaxRate}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnNetAmount}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <VBox>
                                                <Input value="{Description}" editable="{objectView>/editMode}" visible="{objectView>/editMode}"/>
                                                <Text text="{Description}" visible="{= !${objectView>/editMode} }"/>
                                            </VBox>
                                            <VBox>
                                                <Input value="{ path: 'Quantity', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" change=".onItemChange" editable="{objectView>/editMode}" visible="{objectView>/editMode}"/>
                                                <Text text="{ path: 'Quantity', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" visible="{= !${objectView>/editMode} }"/>
                                            </VBox>
                                            <VBox>
                                                <Input value="{ path: 'UnitPrice', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" change=".onItemChange" editable="{objectView>/editMode}" visible="{objectView>/editMode}"/>
                                                <Text text="{ path: 'UnitPrice', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" visible="{= !${objectView>/editMode} }"/>
                                            </VBox>
                                            <VBox>
                                                <Input value="{ path: 'TaxRate', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" change=".onItemChange" editable="{objectView>/editMode}" visible="{objectView>/editMode}"/>
                                                <Text text="{ path: 'TaxRate', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" visible="{= !${objectView>/editMode} }"/>
                                            </VBox>
                                            <Text text="{ path: 'NetAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            
            <uxap:ObjectPageSection title="{i18n>sectionTaxItems}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="taxItemsTable" items="{
                                path: 'TaxItems',
                                templateShareable: true
                            }">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="{i18n>sectionTaxItems}" level="H2"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column hAlign="End"><Text text="{i18n>columnTaxRate}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnTaxBase}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>columnTaxAmount}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{ path: 'TaxRate', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } } %" />
                                            <Text text="{ path: 'TaxBase', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" />
                                            <Text text="{ path: 'TaxAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            
            <uxap:ObjectPageSection title="{i18n>sectionAmounts}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:SimpleForm editable="false" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
                                <form:content>
                                    <Label text="{i18n>fieldNetAmount}" />
                                    <Text text="{ path: 'NetAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } } {Currency}" />
                                    
                                    <Label text="{i18n>fieldGrossAmount}" />
                                    <Text text="{ path: 'GrossAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } } {Currency}" />
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="{i18n>sectionNotes}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <VBox class="sapUiSmallMargin">
                                <TextArea 
                                    value="{objectView>/noteText}" 
                                    editable="{objectView>/editMode}"
                                    width="100%" 
                                    rows="5"/>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>